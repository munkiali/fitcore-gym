<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FITCORE GYM | Management System</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#0d0d0d;
    color:#fff;
}

/* SIDEBAR */
.sidebar{
    width:250px;
    height:100vh;
    position:fixed;
    left:0;
    top:0;
    background:#151515;
    border-right:1px solid #292929;
    padding:25px 15px;
}

.logo{
    font-size:24px;
    font-weight:bold;
    color:#00d9ff;
    margin-bottom:40px;
    text-align:center;
}

.logo span{
    color:#fff;
}

.menu{
    list-style:none;
}

.menu li{
    margin-bottom:10px;
}

.menu a{
    display:block;
    padding:14px;
    color:#aaa;
    text-decoration:none;
    border-radius:10px;
    cursor:pointer;
    transition:.3s;
}

.menu a:hover,
.menu a.active{
    background:#00cfe8;
    color:#000;
}

/* MAIN */
.main{
    margin-left:250px;
    padding:30px;
    min-height:100vh;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:30px;
}

.header p{
    color:#888;
    margin-top:5px;
}

.profile{
    background:#1b1b1b;
    padding:10px 15px;
    border-radius:12px;
}

.avatar{
    width:40px;
    height:40px;
    background:#00cfe8;
    color:#000;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
}

/* DASHBOARD CARDS */
.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.card{
    background:#181818;
    border:1px solid #292929;
    border-radius:15px;
    padding:22px;
}

.card-icon{
    font-size:28px;
    margin-bottom:15px;
}

.card p{
    color:#999;
}

.card h2{
    margin-top:10px;
    font-size:28px;
}

/* PANELS */
.panel{
    background:#181818;
    border:1px solid #292929;
    padding:25px;
    border-radius:16px;
    margin-top:25px;
}

/* BUTTON */
.btn{
    background:#00cfe8;
    border:none;
    padding:12px 18px;
    border-radius:9px;
    cursor:pointer;
    font-size:15px;
    font-weight:bold;
}

.btn:hover{
    opacity:.85;
}

/* MEMBERS HEADER */
.members-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.search{
    width:100%;
    padding:13px;
    background:#111;
    border:1px solid #333;
    border-radius:10px;
    color:#fff;
    margin-bottom:20px;
}

/* TABLE */
.table-box{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
}

th{
    color:#888;
    text-align:left;
    padding:15px;
    border-bottom:1px solid #333;
}

td{
    padding:15px;
    border-bottom:1px solid #252525;
}

.status{
    padding:6px 10px;
    border-radius:20px;
    font-size:12px;
}

.active-status{
    background:#123d43;
    color:#00d9ff;
}

.due-status{
    background:#422424;
    color:#ff7777;
}

.delete-btn{
    background:#ff4d4d;
    border:none;
    color:white;
    padding:7px 10px;
    border-radius:7px;
    cursor:pointer;
}

/* MODAL */
.modal{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.75);
    justify-content:center;
    align-items:center;
    z-index:1000;
}

.modal.show{
    display:flex;
}

.modal-content{
    width:90%;
    max-width:550px;
    max-height:90vh;
    overflow-y:auto;
    background:#181818;
    border:1px solid #333;
    padding:25px;
    border-radius:18px;
}

.modal-content h2{
    margin-bottom:20px;
}

.form-group{
    margin-bottom:15px;
}

.form-group label{
    display:block;
    margin-bottom:7px;
    color:#aaa;
}

.form-group input,
.form-group select{
    width:100%;
    padding:12px;
    border-radius:8px;
    border:1px solid #333;
    background:#111;
    color:white;
}

.form-buttons{
    display:flex;
    gap:10px;
    margin-top:20px;
}

.cancel-btn{
    background:#333;
    color:#fff;
}

/* RECENT MEMBERS */
.member{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px 0;
    border-bottom:1px solid #292929;
}

.member:last-child{
    border:none;
}

.member-info{
    display:flex;
    gap:12px;
    align-items:center;
}

.member-avatar{
    width:42px;
    height:42px;
    border-radius:50%;
    background:#292929;
    display:flex;
    justify-content:center;
    align-items:center;
}

.member-info small{
    color:#888;
}

/* MOBILE */
@media(max-width:800px){

    .sidebar{
        width:70px;
        padding:20px 10px;
    }

    .logo{
        font-size:0;
    }

    .logo:before{
        content:"💪";
        font-size:30px;
    }

    .menu a{
        font-size:0;
        text-align:center;
        padding:14px 5px;
    }

    .menu a:first-letter{
        font-size:20px;
    }

    .main{
        margin-left:70px;
        padding:20px;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .header h1{
        font-size:24px;
    }

    .members-top{
        align-items:flex-start;
        flex-direction:column;
        gap:15px;
    }
}

@media(max-width:500px){

    .main{
        padding:15px;
    }

    .stats{
        gap:12px;
    }

    .card{
        padding:16px;
    }

    .card h2{
        font-size:23px;
    }

    .profile{
        display:none;
    }
}
</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">

    <div class="logo">FIT<span>CORE</span></div>

    <ul class="menu">
        <li><a class="active" onclick="showPage('dashboard',this)">🏠 Dashboard</a></li>
        <li><a onclick="showPage('members',this)">👥 Members</a></li>
        <li><a onclick="showPage('attendance',this)">📅 Attendance</a></li>
        <li><a onclick="showPage('payments',this)">💳 Payments</a></li>
        <li><a onclick="showPage('workout',this)">🏋️ Workout Plans</a></li>
        <li><a onclick="showPage('trainers',this)">🧑‍🏫 Trainers</a></li>
        <li><a onclick="showPage('reports',this)">📊 Reports</a></li>
    </ul>

</div>

<div class="main">

<!-- DASHBOARD -->
<div id="dashboard" class="page active">

    <div class="header">
        <div>
            <h1>Dashboard 👋</h1>
            <p>Welcome back! Here's what's happening today.</p>
        </div>

        <div class="profile">
            <div class="avatar">A</div>
        </div>
    </div>

    <div class="stats">

        <div class="card">
            <div class="card-icon">👥</div>
            <p>Total Members</p>
            <h2 id="totalMembers">0</h2>
        </div>

        <div class="card">
            <div class="card-icon">🟢</div>
            <p>Active Members</p>
            <h2 id="activeMembers">0</h2>
        </div>

        <div class="card">
            <div class="card-icon">⚠️</div>
            <p>Payment Due</p>
            <h2 id="dueMembers">0</h2>
        </div>

        <div class="card">
            <div class="card-icon">💰</div>
            <p>Monthly Revenue</p>
            <h2 id="revenue">₹0</h2>
        </div>

    </div>

    <div class="panel">
        <div class="members-top">
            <h2>Recent Members</h2>
            <button class="btn" onclick="openModal()">➕ Add Member</button>
        </div>

        <div id="recentMembers"></div>
    </div>

</div>


<!-- MEMBERS PAGE -->
<div id="members" class="page">

    <div class="header">
        <div>
            <h1>Members 👥</h1>
            <p>Manage all your gym members.</p>
        </div>

        <button class="btn" onclick="openModal()">➕ Add Member</button>
    </div>

    <div class="panel">

        <input
            type="text"
            class="search"
            placeholder="🔍 Search member..."
            onkeyup="searchMembers(this.value)"
        >

        <div class="table-box">

            <table>

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Plan</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="membersTable"></tbody>

            </table>

        </div>

    </div>

</div>


<!-- PLACEHOLDER PAGES -->
<div id="attendance" class="page">
    <h1>📅 Attendance</h1>
    <div class="panel">Attendance system coming next.</div>
</div>

<div id="payments" class="page">
    <h1>💳 Payments</h1>
    <div class="panel">Payment management coming next.</div>
</div>

<div id="workout" class="page">
    <h1>🏋️ Workout Plans</h1>
    <div class="panel">Workout planner coming soon.</div>
</div>

<div id="trainers" class="page">
    <h1>🧑‍🏫 Trainers</h1>
    <div class="panel">Trainer management coming soon.</div>
</div>

<div id="reports" class="page">
    <h1>📊 Reports</h1>
    <div class="panel">Reports & analytics coming soon.</div>
</div>

</div>


<!-- ADD MEMBER MODAL -->
<div id="memberModal" class="modal">

    <div class="modal-content">

        <h2>➕ Add New Member</h2>

        <form id="memberForm">

            <div class="form-group">
                <label>Full Name</label>
                <input type="text" id="name" required>
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input type="tel" id="phone" required>
            </div>

            <div class="form-group">
                <label>Age</label>
                <input type="number" id="age">
            </div>

            <div class="form-group">
                <label>Membership Plan</label>
                <select id="plan">
                    <option>Monthly</option>
                    <option>Quarterly</option>
                    <option>Half Yearly</option>
                    <option>Yearly</option>
                </select>
            </div>

            <div class="form-group">
                <label>Amount Paid (₹)</label>
                <input type="number" id="amount" required>
            </div>

            <div class="form-group">
                <label>Payment Status</label>
                <select id="status">
                    <option value="Active">Active</option>
                    <option value="Due">Payment Due</option>
                </select>
            </div>

            <div class="form-buttons">
                <button type="submit" class="btn">Save Member</button>
                <button type="button" class="btn cancel-btn" onclick="closeModal()">Cancel</button>
            </div>

        </form>

    </div>

</div>


<script>

/* DATABASE */
let members = JSON.parse(localStorage.getItem("fitcoreMembers")) || [];


/* NAVIGATION */
function showPage(pageId, element){

    document.querySelectorAll(".page").forEach(page=>{
        page.classList.remove("active");
    });

    document.getElementById(pageId).classList.add("active");

    document.querySelectorAll(".menu a").forEach(item=>{
        item.classList.remove("active");
    });

    element.classList.add("active");

}


/* MODAL */
function openModal(){
    document.getElementById("memberModal").classList.add("show");
}

function closeModal(){
    document.getElementById("memberModal").classList.remove("show");
}


/* ADD MEMBER */
document.getElementById("memberForm").addEventListener("submit",function(e){

    e.preventDefault();

    const member = {
        id: Date.now(),
        name:document.getElementById("name").value,
        phone:document.getElementById("phone").value,
        age:document.getElementById("age").value,
        plan:document.getElementById("plan").value,
        amount:Number(document.getElementById("amount").value),
        status:document.getElementById("status").value,
        joined:new Date().toLocaleDateString()
    };

    members.push(member);

    localStorage.setItem("fitcoreMembers",JSON.stringify(members));

    this.reset();

    closeModal();

    updateDashboard();
    renderMembers();

});


/* DASHBOARD */
function updateDashboard(){

    const total=members.length;

    const active=members.filter(m=>m.status==="Active").length;

    const due=members.filter(m=>m.status==="Due").length;

    const revenue=members.reduce((sum,m)=>sum+m.amount,0);

    document.getElementById("totalMembers").innerText=total;

    document.getElementById("activeMembers").innerText=active;

    document.getElementById("dueMembers").innerText=due;

    document.getElementById("revenue").innerText="₹"+revenue;


    const recent=document.getElementById("recentMembers");

    if(members.length===0){

        recent.innerHTML="<p style='color:#888'>No members added yet.</p>";
        return;
    }

    recent.innerHTML=members.slice(-5).reverse().map(member=>`

        <div class="member">

            <div class="member-info">

                <div class="member-avatar">
                    ${member.name.charAt(0).toUpperCase()}
                </div>

                <div>
                    <strong>${member.name}</strong><br>
                    <small>Joined ${member.joined}</small>
                </div>

            </div>

            <span class="status ${member.status==="Active" ? "active-status":"due-status"}">

                ${member.status==="Active" ? "Active":"Payment Due"}

            </span>

        </div>

    `).join("");

}


/* MEMBERS TABLE */
function renderMembers(data=members){

    const table=document.getElementById("membersTable");

    if(data.length===0){

        table.innerHTML=`
            <tr>
                <td colspan="6" style="text-align:center;color:#888;padding:30px">
                    No members found
                </td>
            </tr>
        `;

        return;
    }

    table.innerHTML=data.map(member=>`

        <tr>

            <td>${member.name}</td>
            <td>${member.phone}</td>
            <td>${member.plan}</td>
            <td>₹${member.amount}</td>

            <td>
                <span class="status ${member.status==="Active" ? "active-status":"due-status"}">
                    ${member.status==="Active" ? "Active":"Due"}
                </span>
            </td>

            <td>
                <button
                    class="delete-btn"
                    onclick="deleteMember(${member.id})"
                >
                    Delete
                </button>
            </td>

        </tr>

    `).join("");

}


/* SEARCH */
function searchMembers(query){

    const filtered=members.filter(member=>
        member.name.toLowerCase().includes(query.toLowerCase()) ||
        member.phone.includes(query)
    );

    renderMembers(filtered);

}


/* DELETE */
function deleteMember(id){

    if(confirm("Are you sure you want to delete this member?")){

        members=members.filter(member=>member.id!==id);

        localStorage.setItem("fitcoreMembers",JSON.stringify(members));

        updateDashboard();

        renderMembers();

    }

}


/* INITIAL LOAD */
updateDashboard();
renderMembers();

</script>

</body>
</html>
